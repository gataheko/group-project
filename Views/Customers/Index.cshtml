@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-heading"><div><p class="eyebrow">CUSTOMER MANAGEMENT</p><h1>Customers</h1><p class="muted">View, search and manage customer records.</p></div><a class="button" asp-action="Create">+ Add Customer</a></div>
<div class="panel">
<form method="get" asp-action="Index" class="filters"><input name="search" value="@ViewBag.Search" placeholder="Search name, email or phone" aria-label="Search customers"/><button class="button" type="submit">Search</button><a class="button secondary" asp-action="Index">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Actions</th></tr></thead><tbody>
@foreach(var customer in Model){<tr><td>@customer.Name</td><td>@(customer.Email ?? "—")</td><td>@(customer.Phone ?? "—")</td><td>@(customer.Address ?? "—")</td><td><div class="actions"><a asp-action="Details" asp-route-id="@customer.Id">View</a><a asp-action="Edit" asp-route-id="@customer.Id">Edit</a><a class="danger-text" asp-action="Delete" asp-route-id="@customer.Id">Delete</a></div></td></tr>}
</tbody></table></div>
@if(!Model.Any()){<p class="muted">No customers found. Add a customer to get started.</p>}
</div>
