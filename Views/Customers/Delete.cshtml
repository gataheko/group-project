@model Customer
@{ ViewData["Title"] = "Delete Customer"; }
<div class="page-heading"><h1>Delete Customer</h1></div><div class="panel"><p>Are you sure you want to delete <strong>@Model.Name</strong>?</p><p class="muted">This cannot be undone. Any linked purchase orders will retain their records but lose the customer association.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><button type="submit" class="button">Confirm Delete</button><a class="button secondary" asp-action="Index">Cancel</a></div></form></div>
