@model Customer
@{ ViewData["Title"] = "Customer Details"; }
<div class="page-heading"><h1>Customer Details</h1></div><div class="panel"><h2>@Model.Name</h2><p><strong>Email:</strong> @(Model.Email ?? "—")</p><p><strong>Phone:</strong> @(Model.Phone ?? "—")</p><p><strong>Address:</strong> @(Model.Address ?? "—")</p><div class="form-actions"><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="button secondary" asp-action="Index">Back to Customers</a></div></div>
