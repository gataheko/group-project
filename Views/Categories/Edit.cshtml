@* Reused Create.cshtml because I'm lazy. ~rduehr *@
@model Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ORGANIZATION</p>
        <h1>Edit category</h1>
        <p class="muted">Update the category details below.</p>
    </div>
</div>

<section class="panel">
    @* Tells the browser to submit the form to the Edit POST action. ~Rduehr*@
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @*Inserts _CategoryForm I created right before this, which was the entire point. ~Rduehr*@
        <input type="hidden" asp-for="Id" />
        <partial name="_CategoryForm" model="Model" />
    </form>
</section>
